---
interface Props {
  name: 'arrow-up-right' | 'arrow-down' | 'arrow-right' | 'github' | 'linkedin' | 'download' | 'copy' | 'mail';
  class?: string;
  label?: string;
}
const { name, class: className = 'arrow', label } = Astro.props;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

{
  name === 'arrow-up-right' && (
    <svg class={className} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" {...a11y}>
      <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" />
    </svg>
  )
}
{
  name === 'arrow-right' && (
    <svg class={className} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" {...a11y}>
      <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />
    </svg>
  )
}
{
  name === 'arrow-down' && (
