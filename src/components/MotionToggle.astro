---
import type { Locale } from '../i18n/config';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
---

<button
  class="motion-toggle mono"
  type="button"
  aria-pressed="false"
  data-motion-toggle
  data-label-pause={d.a11y.pauseMotion}
  data-label-play={d.a11y.playMotion}
  hidden
>
  <span class="motion-toggle__icon" aria-hidden="true"></span>
  <span data-motion-label>{d.a11y.pauseMotion}</span>
</button>

<style>
  .motion-toggle {
    position: fixed;
    inset-block-end: calc(var(--frame) + 0.35rem + env(safe-area-inset-bottom));
    inset-inline-end: calc(var(--frame) + 0.35rem);
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line-2);
    background: rgb(10 11 13 / 0.72);
    backdrop-filter: blur(8px);
    color: var(--ink-2);
    transition: color 0.2s, border-color 0.2s;
  }

  .motion-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .motion-toggle[hidden] {
    display: none;
  }

  .motion-toggle__icon {
    inline-size: 0.55rem;
    block-size: 0.6rem;
    border-inline: 2px solid currentColor;
  }

  /* Icon-only on small screens so it never covers reading text. */
  @media (max-width: 899px) {
    .motion-toggle {
      inline-size: 2.5rem;
      block-size: 2.5rem;
      padding: 0;
      justify-content: center;
    }

    .motion-toggle [data-motion-label] {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .motion-toggle[aria-pressed='true'] .motion-toggle__icon {
    inline-size: 0;
    block-size: 0;
    border-block: 0.32rem solid transparent;
    border-inline-start: 0.55rem solid currentColor;
    border-inline-end: 0;
  }
</style>
