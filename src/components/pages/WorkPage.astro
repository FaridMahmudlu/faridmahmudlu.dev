---
import { getEntry, render } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { t, formatPeriod } from '../../i18n';
import { homePath, pathFor } from '../../i18n/routes';
import { roleKey, work, workBySlug } from '../../data/work';
import { profile } from '../../data/profile';
import { workGraph } from '../../lib/seo';
import { BUILD_DATE } from '../../lib/build';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const d = t(locale);
const item = workBySlug(slug);
const entry = await getEntry('work', `${locale}/${slug}`);
if (!item || !entry) throw new Error(`Missing work data or content for "${locale}/${slug}"`);
const { Content } = await render(entry);

const index = work.findIndex((w) => w.slug === slug);
const next = work[(index + 1) % work.length]!;
const layer = d.layers[item.layer];
const title = `${entry.data.title}${d.meta.titleSuffix}`;
const jsonLd = workGraph({ locale, title, description: entry.data.description, modified: BUILD_DATE }, item);
---

<Base
  locale={locale}
  page={{ type: 'work', slug }}
  title={title}
  description={entry.data.description}
  jsonLd={jsonLd}
  ogType="article"
  signal={item.layer}
  bodyClass="is-case"
>
  <article class="case" aria-labelledby="case-title">
    <header class="case__head wrap" data-formation={item.layer} data-chapter={layer.index} data-chapter-label={layer.name}>
      <nav class="crumbs mono" aria-label={d.a11y.breadcrumb}>
        <ol role="list">
          <li><a href={homePath(locale)}>{profile.name}</a></li>
          <li><a href={homePath(locale, 'work')}>{d.case.work}</a></li>
          <li><span aria-current="page">{item.name}</span></li>
        </ol>
      </nav>

      <p class="kicker mono">
        <b>{d.case[roleKey(item)]}</b>
        <span>· {layer.index} {layer.name}</span>
      </p>
      <h1 id="case-title" class="case__title" data-split>{item.name}</h1>
      <p class="lead case__headline" data-reveal data-d="150">{entry.data.headline}</p>
    </header>

    <div class="case__meta-wrap wrap" data-formation="field">
      <dl class="case__meta">
        <div>
          <dt class="mono">{d.case.role}</dt>
          <dd>{d.work.roles[roleKey(item)]}</dd>
        </div>
        <div>
          <dt class="mono">{d.case.period}</dt>
          <dd>{formatPeriod(item.start, item.end, locale)}</dd>
        </div>
        <div class="case__meta-stack">
          <dt class="mono">{d.case.stack}</dt>
          <dd>
            <ul class="tags" role="list">
              {item.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </dd>
        </div>
        {
          (item.live || item.repo) && (
            <div>
              <dt class="mono">{d.case.links}</dt>
              <dd class="case__links">
                {item.live && (
                  <a href={item.live} target="_blank" rel="noopener" class="link">
                    {d.work.live} <Icon name="arrow-up-right" />
                    <span class="visually-hidden">{d.a11y.external}</span>
                  </a>
                )}
                {item.repo && (
                  <a href={item.repo} target="_blank" rel="noopener" class="link">
                    {d.work.code} <Icon name="arrow-up-right" />
                    <span class="visually-hidden">{d.a11y.external}</span>
                  </a>
                )}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="prose case__body">
        <Content />
      </div>
    </div>

    <nav class="case__next wrap" aria-label={d.case.next} data-formation={next.layer}>
      <a class="case__all mono" href={homePath(locale, 'work')}>
        <Icon name="arrow-right" class="arrow arrow--back" />
        {d.case.all}
      </a>
      <a class="case__next-link" href={pathFor({ type: 'work', slug: next.slug }, locale)}>
        <span class="mono muted">{d.case.next}</span>
        <span class="case__next-name">{next.name}</span>
        <span class="muted case__next-summary">{d.work.summaries[next.slug]}</span>
        <Icon name="arrow-right" class="arrow case__next-arrow" />
      </a>
    </nav>
  </article>
</Base>

<style>
  .case__head {
    min-block-size: 92svh;
    display: grid;
    align-content: end;
    gap: clamp(1rem, 2.4vw, 1.75rem);
    padding-block: calc(var(--header-h) + 3rem) clamp(3rem, 7vw, 5rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--ink-3);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.5rem;
    color: var(--ink-3);
  }

  .crumbs a {
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .crumbs a:hover {
    color: var(--signal);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .crumbs {
    margin-block-end: auto;
    padding-block-end: 2rem;
  }

  .case__title {
    font-size: clamp(3.25rem, 1rem + 9vw, 10.5rem);
    font-stretch: 112%;
    font-weight: 620;
    letter-spacing: -0.05em;
    line-height: 0.88;
    max-inline-size: 12ch;
  }

  .case__headline {
    max-inline-size: 34ch;
  }

  .case__meta-wrap {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 0.4rem + 1.2vw, 1.5rem);
    padding-block: clamp(2rem, 4vw, 3rem) var(--section-y);
  }

  .case__meta-wrap::before {
    content: '';
    position: absolute;
    inset: 0 0 0;
    z-index: -1;
    background: linear-gradient(to bottom, transparent, rgb(10 11 13 / 0.92) 12rem);
  }

  .case__meta {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    inset-block-start: calc(var(--header-h) + 1.5rem);
    display: grid;
    border-block-start: 1px solid var(--line-2);
  }

  .case__meta > div {
    display: grid;
    gap: 0.4rem;
    padding-block: 1rem;
    border-block-end: 1px solid var(--line);
  }

  .case__meta dt {
    color: var(--ink-3);
  }

  .case__links {
    display: flex;
    gap: 1.25rem;
  }

  .case__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .case__body {
    grid-column: 6 / span 7;
  }

  .case__next {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5rem) var(--section-y);
    border-block-start: 1px solid var(--line);
    position: relative;
    background: var(--bg);
  }

  .case__all {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    inline-size: fit-content;
    min-block-size: 2.5rem;
    color: var(--ink-2);
  }

  .case__all:hover {
    color: var(--signal);
  }

  :global(.arrow--back) {
    transform: rotate(180deg);
  }

  .case__next-link {
    display: grid;
    gap: 0.75rem;
    position: relative;
    padding-inline-end: 4rem;
  }

  .case__next-name {
    font-size: clamp(2.75rem, 1rem + 7vw, 8rem);
    font-stretch: 112%;
    font-weight: 620;
    letter-spacing: -0.05em;
    line-height: 0.9;
    transition: color 0.3s, transform 0.6s var(--ease-out);
  }

  .case__next-link:hover .case__next-name {
    color: var(--signal);
    transform: translateX(0.5rem);
  }

  :global(.case__next-arrow) {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0.5rem;
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }

  @media (max-width: 999px) {
    .case__meta,
    .case__body {
      grid-column: 1 / -1;
    }

    .case__meta {
      position: static;
      margin-block-end: 3rem;
    }
  }
</style>
