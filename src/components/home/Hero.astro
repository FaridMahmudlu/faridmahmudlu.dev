---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n';
import { profile } from '../../data/profile';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="hero" id="hero" data-formation="core" data-chapter="SIG" data-chapter-label={d.hud.signal} aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <dl class="hero__meta mono">
      {
        d.hero.meta.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="hero__main">
      <p class="hero__kicker kicker mono"><b>{d.hero.kicker}</b></p>
      <h1 id="hero-title" class="hero__title" data-hero-title>
        <span class="hero__line">{profile.givenName}</span>
        <span class="hero__line hero__line--2">{profile.familyName}</span>
      </h1>
    </div>

    <p class="hero__statement">{d.hero.statement}</p>

    <a class="hero__scroll mono" href="#origin">
      <span class="hero__scroll-track" aria-hidden="true"><span></span></span>
      {d.hero.scroll}
      <Icon name="arrow-down" />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: flex;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(0.75rem, 0.4rem + 1.2vw, 1.5rem);
    padding-block: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem)) clamp(2rem, 5vh, 3.5rem);
  }

  .hero__meta {
    grid-column: 1 / span 4;
    grid-row: 1;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .hero__meta div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.35rem;
    border-block-end: 1px solid var(--line);
  }

  .hero__meta dt {
    color: var(--ink-3);
  }

  .hero__meta dd {
    color: var(--ink);
  }

  .hero__main {
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: end;
  }

  .hero__kicker {
    margin-block-end: clamp(1rem, 2.5vh, 1.75rem);
  }

  .hero__title {
    display: grid;
    font-size: var(--fs-display);
    font-stretch: 112%;
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 0.84;
    margin-inline-start: -0.04em;
    will-change: transform;
  }

  .hero__line--2 {
    padding-inline-start: 0.9em;
  }

  /* The statement sits to the right of the short first line ("Farid"). */
  .hero__statement {
    grid-column: 7 / -1;
    grid-row: 3;
    align-self: start;
    justify-self: end;
    max-inline-size: 31ch;
    margin-block-start: calc(var(--fs-mono) * 1.5 + clamp(1rem, 2.5vh, 1.75rem) + 0.5rem);
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: var(--ink);
  }

  .hero__scroll {
    grid-column: 9 / -1;
    grid-row: 3;
    align-self: end;
    justify-self: end;
    margin-block-end: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-block-size: 2.75rem;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .hero__scroll:hover {
    color: var(--ink);
  }

  .hero__scroll-track {
    position: relative;
    inline-size: 3.5rem;
    block-size: 1px;
    background: var(--line-2);
    overflow: hidden;
  }

  .hero__scroll-track span {
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform: translateX(-100%);
    animation: track 2.4s var(--ease-in-out) infinite;
  }

  @keyframes track {
    55% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 1099px) {
    .hero__inner {
      grid-template-rows: auto 1fr auto auto;
    }

    .hero__statement {
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: end;
      justify-self: start;
      margin-block: 2rem 2.25rem;
    }

    .hero__main {
      grid-row: 3;
    }

    .hero__scroll {
      grid-column: 1 / -1;
      grid-row: 4;
      justify-self: start;
      margin-block: 1.75rem 0;
    }
  }

  /* Keep text legible where it crosses the particle field. */
  .hero__meta,
  .hero__statement,
  .hero__kicker {
    text-shadow:
      0 0 0.5em var(--bg),
      0 0 1.2em var(--bg);
  }

  @media (max-width: 699px) {
    .hero__meta {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }

    .hero__meta div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .hero__line--2 {
      padding-inline-start: 0;
    }

    .hero__statement {
      margin-block: 1.5rem 1.75rem;
    }
  }
</style>
