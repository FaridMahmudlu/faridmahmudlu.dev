# Response headers for Cloudflare Workers static assets.
# The build emits no inline scripts or styles, so the CSP needs no
# 'unsafe-inline', hashes or nonces. The only third-party origin is the
# cookieless Cloudflare Web Analytics beacon.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; worker-src 'self'; require-trusted-types-for 'script'; trusted-types signal-worker
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Cross-Origin-Resource-Policy: cross-origin

/favicon.ico
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/cv/*
  X-Robots-Tag: noindex, noarchive
  Cache-Control: public, max-age=86400

/llms.txt
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

/llms-full.txt
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *
